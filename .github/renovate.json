{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigestsToSemver",
    "security:minimumReleaseAgeNpm",
    "docker:pinDigests",
    ":configMigration",
    ":docker",
    ":separateMajorReleases",
    ":separateMultipleMinorReleases",
    ":separatePatchReleases",
    ":pinVersions",
    "github>cryostatio/cryostat//.github/renovate/release-branch/lockdown",
    "github>cryostatio/cryostat//.github/renovate/release-branch/default(npm)",
    "github>cryostatio/cryostat//.github/renovate/release-branch/default(dockerfile)"
  ],
  "baseBranchPatterns": ["main", "/^cryostat-v.*/"],
  "reviewersFromCodeOwners": true,
  "labels": ["dependencies", "chore", "safe-to-test"],
  "stopUpdatingLabel": "blocked",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the VALIDATOR_VERSION pin that the config validator workflow passes to npx, so Renovate raises a PR to bump its own validator",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "VALIDATOR_VERSION:\\s*(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm"
    }
  ],
  "semanticCommits": "enabled",
  "major": {
    "dependencyDashboardApproval": true
  },
  "git-submodules": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Allow the cryostat-web submodule to update on release branches, tracking the matching cryostat-web release branch",
      "matchBaseBranches": ["/^cryostat-v.*/"],
      "matchManagers": ["git-submodules"],
      "enabled": true
    },
    {
      "matchFileNames": [".devcontainer/**"],
      "enabled": false
    },
    {
      "matchFileNames": ["charts/**"],
      "pinDigests": false
    },
    {
      "groupName": "openshift",
      "dependencyDashboardApproval": true,
      "matchPackageNames": ["/^@openshift/"]
    },
    {
      "groupName": "react ecosystem",
      "dependencyDashboardApproval": true,
      "matchPackageNames": [
        "/^react/",
        "/^@types/react/",
        "/^@testing-library/react/"
      ]
    },
    {
      "groupName": "patternfly",
      "dependencyDashboardApproval": true,
      "matchPackageNames": ["/^@patternfly//"]
    },
    {
      "groupName": "redux",
      "dependencyDashboardApproval": true,
      "matchPackageNames": ["/^@reduxjs//", "/^redux/", "/^react-redux/"]
    }
  ]
}

