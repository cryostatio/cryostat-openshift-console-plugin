{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigestsToSemver",
    "security:minimumReleaseAgeNpm",
    "docker:pinDigests",
    ":configMigration",
    ":docker",
    ":separateMajorReleases",
    ":separateMultipleMinorReleases",
    ":separatePatchReleases",
    ":pinVersions"
  ],
  "baseBranchPatterns": ["main", "/^cryostat-v.*/"],
  "reviewersFromCodeOwners": true,
  "labels": ["dependencies", "chore", "safe-to-test"],
  "stopUpdatingLabel": "blocked",
  "semanticCommits": "enabled",
  "major": {
    "dependencyDashboardApproval": true
  },
  "git-submodules": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Disable all dependency updates on release branches except the cryostat-web submodule and Dockerfile base images; other updates there are handled via Mergify backport",
      "matchBaseBranches": ["/^cryostat-v.*/"],
      "enabled": false
    },
    {
      "description": "Allow the cryostat-web submodule to update on release branches, tracking the matching cryostat-web release branch",
      "matchBaseBranches": ["/^cryostat-v.*/"],
      "matchManagers": ["git-submodules"],
      "enabled": true
    },
    {
      "description": "Allow Dockerfile base image updates on release branches",
      "matchBaseBranches": ["/^cryostat-v.*/"],
      "matchManagers": ["dockerfile"],
      "enabled": true
    },
    {
      "matchFileNames": [".devcontainer/**"],
      "enabled": false
    },
    {
      "matchFileNames": ["charts/**"],
      "pinDigests": false
    },
    {
      "groupName": "openshift",
      "dependencyDashboardApproval": true,
      "matchPackageNames": ["/^@openshift/"]
    },
    {
      "groupName": "react ecosystem",
      "dependencyDashboardApproval": true,
      "matchPackageNames": [
        "/^react/",
        "/^@types/react/",
        "/^@testing-library/react/"
      ]
    },
    {
      "groupName": "patternfly",
      "dependencyDashboardApproval": true,
      "matchPackageNames": ["/^@patternfly//"]
    },
    {
      "groupName": "redux",
      "dependencyDashboardApproval": true,
      "matchPackageNames": ["/^@reduxjs//", "/^redux/", "/^react-redux/"]
    }
  ]
}

